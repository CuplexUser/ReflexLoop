{
  "id": "fixture_json",
  "label": "Fixture (JSON)",
  "baseUrl": "https://api.fixture.example/v4",
  "auth": { "type": "bearer", "envVar": "FIXTURE_JSON_TOKEN" },
  "encoding": "json",
  "operations": [
    {
      "name": "fixture_json_send",
      "risk": "read",
      "description": "Test fixture: a JSON body with an array param.",
      "method": "POST",
      "path": "/send",
      "params": {
        "from": { "type": "string", "in": "body", "required": true },
        "to": { "type": "string[]", "in": "body", "required": true },
        "subject": { "type": "string", "in": "body", "required": true },
        "text": { "type": "string", "in": "body" }
      }
    },
    {
      "name": "fixture_json_get_project",
      "risk": "read",
      "description": "Test fixture: path params.",
      "method": "GET",
      "path": "/accounts/{accountId}/projects/{projectName}",
      "params": {
        "accountId": { "type": "string", "in": "path", "required": true },
        "projectName": { "type": "string", "in": "path", "required": true }
      }
    },
    {
      "name": "fixture_json_aggregate",
      "risk": "read",
      "description": "Test fixture: query params with a wire name and a default.",
      "method": "GET",
      "path": "/stats/aggregate",
      "params": {
        "siteId": { "type": "string", "in": "query", "as": "site_id", "required": true },
        "period": { "type": "string", "in": "query", "default": "30d" }
      }
    },
    {
      "name": "fixture_json_graphql",
      "risk": "read",
      "description": "Test fixture: a GraphQL body driven by a flat signature through dotted wire names.",
      "method": "POST",
      "path": "/graphql",
      "params": {
        "query": { "type": "string", "in": "body", "default": "query($accountTag: string!, $siteTag: string!) { viewer { accounts { totals: rumPageloadEventsAdaptiveGroups { count } } } }" },
        "accountTag": { "type": "string", "in": "body", "as": "variables.accountTag", "required": true },
        "siteTag": { "type": "string", "in": "body", "as": "variables.siteTag", "required": true },
        "since": { "type": "string", "in": "body", "as": "variables.since", "required": true },
        "until": { "type": "string", "in": "body", "as": "variables.until", "required": true }
      },
      "result": { "totals": "data.viewer.accounts.0.totals" }
    },
    {
      "name": "fixture_json_shaped",
      "risk": "read",
      "description": "Test fixture: a nested response shaped into flat keys.",
      "method": "POST",
      "path": "/records",
      "params": {
        "name": { "type": "string", "in": "body", "required": true }
      },
      "result": { "id": "result.id", "name": "result.name", "type": "result.type" }
    },
    {
      "name": "fixture_json_list_zones",
      "risk": "read",
      "description": "Test fixture: a shaping map that may resolve nothing.",
      "method": "GET",
      "path": "/zones",
      "result": { "zones": "result" }
    },
    {
      "name": "fixture_json_list_sites",
      "risk": "read",
      "description": "Test fixture: a projected list with a nested field.",
      "method": "GET",
      "path": "/sites",
      "resultList": { "path": "result", "fields": ["site_tag", "ruleset.zone_name"] }
    }
  ]
}
