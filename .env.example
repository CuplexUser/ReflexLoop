# ---- which model runs the agent -----------------------------------------
#
# This runner talks to model APIs directly -- there is no Claude Code / Agent SDK
# involved, and nothing here is Claude-specific. Pick a provider, set its key, and
# name a model.
#
# NOTE: provider and model (and the per-phase overrides below) are editable from the
# console's Settings page, and take effect without a restart. Once you set one there
# it wins over the value here -- these become the seed for a database that has never
# had them set, not the source of truth. The page says, per setting, which one is in
# force. API keys are the exception and stay here: see the note by the keys below.

# openrouter | openai | anthropic | xai | moonshot. Default: openrouter.
# OpenRouter is the default because one key reaches Claude, GPT, Grok and Kimi, and
# it reports the real dollar cost of every call -- which keeps the console's Economics
# page accurate without this repo having to maintain a pricing table.
AGENT_PROVIDER=openrouter

# Required, no default. Providers rename and retire models constantly, so a model id
# baked into the code would fail at the first API call with an opaque 404 instead of
# at startup with a message you can act on. Look yours up:
#   openrouter -> https://openrouter.ai/models          (slugs look like "vendor/model")
#   openai     -> https://platform.openai.com/docs/models
#   anthropic  -> https://platform.claude.com/docs/en/about-claude/models/overview
#   xai        -> https://docs.x.ai/docs/models
#   moonshot   -> https://platform.moonshot.ai/docs/introduction
AGENT_MODEL=

# Set the key for whichever provider you chose above. The others can stay blank.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=

# Optional per-phase overrides. Unset values fall back to AGENT_PROVIDER/AGENT_MODEL,
# so leave all six blank for a single-model setup. Provider and model override
# independently -- setting only AGENT_ACT_MODEL keeps the base provider and swaps the
# model on it, which is what you want when both models sit behind one OpenRouter key.
#
# Worth splitting because the phases want different things: research is long, wide and
# cheap to get wrong; the deep dive (AGENT_ACT_*, named for the phase key it inherited)
# is the longest and most source-heavy phase, and its report is what you act on;
# reflect is two short memory calls.
AGENT_RESEARCH_PROVIDER=
AGENT_RESEARCH_MODEL=
AGENT_ACT_PROVIDER=
AGENT_ACT_MODEL=
AGENT_REFLECT_PROVIDER=
AGENT_REFLECT_MODEL=

# Max output tokens per model call. Default: 32768. A deep dive submits its whole report in a
# single tool call, so a low value here doesn't produce a shorter report, it produces one cut
# off mid-section. Leave it empty to take the default; only lower it for a provider that rejects
# a cap above its model's limit instead of clamping to it.
AGENT_MAX_TOKENS=

# Sampling temperature. Left unset on purpose: several current models reject any
# non-default sampling parameter outright, and it is never sent to Anthropic.
AGENT_TEMPERATURE=

# Override a provider's API root (self-hosted gateway, proxy, or Moonshot's mainland
# China endpoint: https://api.moonshot.cn/v1). All optional.
OPENROUTER_BASE_URL=
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
XAI_BASE_URL=
MOONSHOT_BASE_URL=

# Cost accounting for a model this repo has no list price for. Anthropic prices are
# built in and OpenRouter reports real per-call cost, so you only need these if you're
# on OpenAI/xAI/Moonshot directly -- without them those runs record $0 and the
# Economics page understates spend (startup warns once when this happens).
AGENT_PRICE_INPUT_PER_MTOK=
AGENT_PRICE_OUTPUT_PER_MTOK=
AGENT_PRICE_CACHED_INPUT_PER_MTOK=

# ---- web search ----------------------------------------------------------
#
# WebSearch and WebFetch used to come free from Claude Code. WebFetch is now built in
# (src/tools/web.ts); WebSearch needs a backend:
#
#   auto   (default) -- Tavily if its key is set, else Brave, else native.
#   tavily -- results come back as summarized passages, so research often answers
#             straight from them instead of spending a WebFetch on every link.
#   brave  -- ordinary web results; cheaper and more neutral, more follow-up fetches.
#   native -- no local search tool; the model's own provider searches server-side.
#             No extra key, but quality and behaviour vary by provider, and OpenAI
#             only honours it on its search-enabled models.
#   none   -- no web search at all. Research still has WebFetch, the read-only
#             GitHub search and any configured connectors.
#
# Whichever you pick, "WebSearch" stays one tool name in every phase's grant and one
# badge in the console.
#
# Editable from the console's Settings page; a value set there wins over this one.
# The two keys below are not -- they stay in .env like every other credential.
AGENT_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---- the loop ------------------------------------------------------------

# Comma-separated goals (research lanes) each cycle considers. Ideas can come
# from whichever goal looks best that cycle -- they aren't forced to rotate
# evenly. Ideas need not be software: any business with a buyer counts.
#
# SEED ONLY, and only for a database that has never had goals. On first run each
# entry here becomes a row in the `goals` table -- the part before the first comma
# or dash becomes the goal's title (the stable key everything is filed under), and
# the whole string becomes its brief (the instructions the research prompt reads
# word for word). After that, goals are edited on the console's Goals page and this
# value does nothing. Same seed-only rule for AGENT_CYCLE_INTERVAL_MS below.
#
# To fall back to this value, clear the goals: DELETE FROM goals; and
# DELETE FROM control_settings WHERE key = 'domains';
AGENT_DOMAINS=low-startup-cost service businesses,underserved B2B niches for small businesses,consumer subscription or digital products

# How often (ms) the main loop starts a new research cycle. Default: 1h.
AGENT_CYCLE_INTERVAL_MS=3600000

# Research pauses (doesn't stop, just skips filing more) once this many
# ideas are sitting pending review, so the queue can't grow unbounded
# while you're away. Default: 5
#
# Editable from the console's Settings page; a value set there wins over this one.
AGENT_MAX_PENDING_PROPOSALS=5

# Path to the SQLite database file. Default: ./data/agent.db
AGENT_DB_PATH=./data/agent.db

# Port for the web UI's REST + WebSocket API (src/server.ts). Default: 4001
AGENT_SERVER_PORT=4001

# Shared secret gating /api and the WebSocket upgrade. Leave blank and the console
# is unauthenticated (fine on loopback, and the server logs a warning at startup).
# Set it to any long random string before binding anywhere reachable -- the console
# prompts for it once and remembers it. It's one shared secret for the whole console,
# not per-user auth.
AGENT_API_TOKEN=

# Interface the API server binds to. Default: 127.0.0.1 (loopback only).
# Change to 0.0.0.0 to reach the console from another device -- only do that with
# AGENT_API_TOKEN set, since nothing else gates the approve endpoint (and an
# approval spends money on a deep dive).
AGENT_BIND_HOST=127.0.0.1

# ---- review notifications ------------------------------------------------
# Where to push a message when an idea starts waiting for review. The review
# step is the only place the loop blocks indefinitely -- without this the agent
# finishes a cycle at 03:00 and waits until someone opens the console.
#
# Paste a webhook URL and the flavour is detected from its host: Slack
# (hooks.slack.com), Discord (discord.com/api/webhooks/...), ntfy
# (https://ntfy.sh/<your-topic> -- no account needed, works to a phone), or
# anything else, which gets a plain JSON POST. Leave empty for no notifications.
#
# This is a credential: whoever holds the URL can post as you. It stays here
# with the API keys rather than moving to the console's Settings page.
AGENT_NOTIFY_URL=

# Base URL the notification should link back to, so the message is tappable
# straight through to /proposals/<id>. Defaults to http://127.0.0.1:<port>,
# which only works on the machine running the agent -- set this if you review
# from a phone or another machine.
AGENT_CONSOLE_URL=

# ---- research data sources (each optional -- omit to leave its tools out) --

# GitHub personal access token. Read-only use: searching public repos for
# software competitors and reading their READMEs. No write scope needed --
# the agent has no tool that writes to GitHub.
GITHUB_TOKEN=

# ---- connectors (src/connectors/defs/*.json) -----------------------------
# Declarative REST connectors, all read-only (a manifest declaring a write
# operation is refused at load). A connector with no key is left out of
# every phase's grant; filling a key in takes effect on the next cycle with
# no restart.

# DataForSEO credentials as login:password (NOT base64 -- it is encoded per
# call). Real Google Ads monthly search volume and CPC for a batch of keywords
# -- demand evidence that is otherwise guessed from the wording of search
# results. Costs money per call; the response reports the exact charge.
DATAFORSEO_AUTH=

# Hacker News search and TED (EU public procurement notices) need no key at
# all and are always available.

# Directory of additional connector manifests, loaded alongside the bundled
# ones. Optional -- for connectors you don't want to keep in the repo.
AGENT_CONNECTORS_DIR=

# Qdrant Cloud cluster URL + API key for semantic search over research notes
# and lessons (vector storage + free built-in embedding inference in one
# request -- no separate embeddings provider needed). Without these set,
# search silently falls back to the old LIKE-based text match. Create a free
# cluster at https://cloud.qdrant.io (no credit card required).
QDRANT_URL=
QDRANT_API_KEY=

# Exact embedding model identifier to use for Cloud Inference, e.g.
# "sentence-transformers/all-MiniLM-L6-v2". Free-tier ("Cost: Free") models
# and their vector dimensions are listed per-cluster: Cloud Console -> your
# cluster -> Inference tab. Both this and QDRANT_EMBEDDING_DIM are required
# for Qdrant to be used -- get the dimension wrong and collection creation
# will mismatch the model's actual output size.
QDRANT_EMBEDDING_MODEL=
QDRANT_EMBEDDING_DIM=

# Distance metric for the collections Qdrant creates. Default: Cosine.
QDRANT_EMBEDDING_DISTANCE=

# Sparse model for the lexical half of hybrid search, fused with the dense results
# using Reciprocal Rank Fusion. Default: Qdrant/bm25 -- unlike the dense model this
# has a sensible default, because BM25 is provided by Qdrant itself and has no
# dimension to match. It's what catches rare exact terms an embedding model blurs
# (a product name, "periodiseringsfond", a specific competitor).
#
# Set to "off" for dense-only search, if your cluster's inference tier doesn't
# offer it. Search still works; it just loses the lexical leg.
QDRANT_SPARSE_MODEL=
